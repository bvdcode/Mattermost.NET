<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;netstandard2.1</TargetFrameworks>
		<LangVersion>8.0</LangVersion>
		<Nullable>enable</Nullable>
		<Authors>Vadim Belov</Authors>
		<Company>bvdcode</Company>
		<Product>Mattermost.NET</Product>
		<Description>Ready-to-use library for convenient development of Mattermost bots with real-time updates.</Description>
		<PackageReleaseNotes>Release 4.0.5. Adds typed support for Mattermost interactive post action menus, including button and select actions, static options, user data sources, default selections, and integration context payloads. Updates the public API coverage notes and README examples so the new action models are documented alongside the existing post action style support.</PackageReleaseNotes>
		<Copyright>Copyright © Vadim Belov 2025</Copyright>
		<Summary>Ready-to-use library for convenient development of Mattermost bots with real-time updates.</Summary>
		<NeutralLanguage>en-US</NeutralLanguage>
		<Title>Mattermost.NET</Title>
		<PackageId>Mattermost.NET</PackageId>
		<PackageTags>mattermost</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>package-icon.png</PackageIcon>
		<PackageProjectUrl>https://github.com/bvdcode/Mattermost.NET</PackageProjectUrl>
		<RepositoryUrl>https://github.com/bvdcode/Mattermost.NET</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<RootNamespace>Mattermost</RootNamespace>
		<AssemblyName>Mattermost.NET</AssemblyName>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>
	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="package-icon.png" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE.md" Pack="true" PackagePath="LICENSE.md" />
		<PackageReference Include="System.Text.Json" Version="10.0.6" />
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.202" PrivateAssets="All" />
	</ItemGroup>
</Project>
